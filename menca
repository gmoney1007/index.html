<script>
  // mobile menu (simple toggle -> scrolls links into a stacked panel)
  const menuBtn = document.getElementById('menuBtn');
  const navLinks = document.querySelector('nav.links');
  menuBtn.addEventListener('click', () => {
    const open = navLinks.style.display === 'flex';
    navLinks.style.display = open ? 'none' : 'flex';
    navLinks.style.cssText += open ? '' : 'position:fixed; top:78px; left:0; right:0; background:#0c0b09; flex-direction:column; padding:24px 32px; border-bottom:1px solid #332c1e; gap:22px;';
  });

  // ---------- before/after slider factory ----------
  function initSlider(root){
    const wrap = root.querySelector('.ba-before-wrap');
    const before = root.querySelector('.ba-before');
    const handle = root.querySelector('.ba-handle');
    let dragging = false;

    function setPos(pct){
      pct = Math.max(0, Math.min(100, pct));
      wrap.style.width = pct + '%';
      before.style.width = (10000 / pct).toFixed(1) + '%'; // keep bg proportional-ish
      handle.style.left = pct + '%';
    }
    setPos(50);

    function fromEvent(e){
      const rect = root.getBoundingClientRect();
      const x = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
      return (x / rect.width) * 100;
    }
    root.addEventListener('pointerdown', e => { dragging = true; setPos(fromEvent(e)); });
    window.addEventListener('pointermove', e => { if(dragging) setPos(fromEvent(e)); });
    window.addEventListener('pointerup', () => dragging = false);
    root.addEventListener('keydown', e => {
      const cur = parseFloat(handle.style.left) || 50;
      if(e.key === 'ArrowLeft') setPos(cur - 5);
      if(e.key === 'ArrowRight') setPos(cur + 5);
    });
  }
  document.querySelectorAll('.ba').forEach(initSlider);

  // ---------- populate "Our Work" grid ----------
  const jobs = [
    {title:'Marble Floor Restoration', tag:'Marble · Ramsey, NJ', cap:'Etching removed, honed & polished'},
    {title:'Kitchen Countertop Refinish', tag:'Granite · Mahwah, NJ', cap:'Deep scratches removed & resealed'},
    {title:'Outdoor Travertine Patio', tag:'Travertine · Franklin Lakes, NJ', cap:'Filled, leveled & refinished'},
    {title:'Bathroom Vanity Restoration', tag:'Marble · Allendale, NJ', cap:'Chip repair & polish'},
    {title:'Commercial Lobby Floor', tag:'Marble · Paramus, NJ', cap:'Full strip, hone & polish'},
    {title:'Countertop Chip Repair', tag:'Granite · Ridgewood, NJ', cap:'Precision fill & blend'}
  ];
  const grid = document.getElementById('workGrid');
  jobs.forEach(job => {
    const card = document.createElement('div');
    card.className = 'work-card';
    card.innerHTML = `
      <div class="ba" tabindex="0" aria-label="Before and after slider, drag to compare">
        <div class="ba-layer ba-after"></div>
        <div class="ba-before-wrap"><div class="ba-layer ba-before" style="width:170%;"></div></div>
        <span class="ba-tag before-tag">Before</span>
        <span class="ba-tag after-tag">After</span>
        <div class="ba-handle"></div>
        <span class="ba-cap">${job.cap}</span>
      </div>
      <div class="work-meta">
        <h4>${job.title}</h4>
        <span>${job.tag}</span>
      </div>
    `;
    grid.appendChild(card);
    initSlider(card.querySelector('.ba'));
  });

  // ---------- upload box ----------
  const uploadBox = document.getElementById('uploadBox');
  const fileInput = document.getElementById('fileInput');
  const fileList = document.getElementById('fileList');
  let files = [];

  uploadBox.addEventListener('click', () => fileInput.click());
  ['dragover','dragenter'].forEach(evt => uploadBox.addEventListener(evt, e => { e.preventDefault(); uploadBox.style.borderColor = '#c9a24b'; }));
  ['dragleave','drop'].forEach(evt => uploadBox.addEventListener(evt, e => { e.preventDefault(); uploadBox.style.borderColor = ''; }));
  uploadBox.addEventListener('drop', e => handleFiles(e.dataTransfer.files));
  fileInput.addEventListener('change', e => handleFiles(e.target.files));

  function handleFiles(list){
    Array.from(list).forEach(f => files.push(f));
    renderFiles();
  }
  function renderFiles(){
    fileList.innerHTML = '';
    files.forEach((f, i) => {
      const chip = document.createElement('div');
      chip.className = 'file-chip';
      chip.innerHTML = `<span>${f.name}</span>`;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = '×';
      btn.addEventListener('click', () => { files.splice(i,1); renderFiles(); });
      chip.appendChild(btn);
      fileList.appendChild(chip);
    });
  }

  // ---------- form submit (front-end only placeholder) ----------
  const form = document.getElementById('estimateForm');
  const note = document.getElementById('formNote');
  form.addEventListener('submit', e => {
    e.preventDefault();
    note.textContent = 'Thanks — your request has been noted. (Connect this form to email / a backend to go live.)';
    note.classList.add('success');
    form.reset();
    files = [];
    renderFiles();
  });
</script>
